{
  "name": "vscode-csv-plot",
  "displayName": "CSV & Excel Plot",
  "description": "Plot the columns of a CSV file or an Excel sheet as interactive line or stacked-area charts or histograms with statistics, with timestamp support and automatic multiple Y axes.",
  "version": "1.1.0",
  "publisher": "harrahx3",
  "author": {
    "name": "harrahx3"
  },
  "license": "MIT",
  "icon": "assets/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/harrahx3/vscode-csv-plot.git"
  },
  "bugs": {
    "url": "https://github.com/harrahx3/vscode-csv-plot/issues"
  },
  "homepage": "https://github.com/harrahx3/vscode-csv-plot#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Data Science"
  ],
  "keywords": [
    "csv",
    "tsv",
    "chart",
    "plot",
    "time series",
    "excel",
    "xlsx",
    "xls"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "csvPlot.graph",
        "displayName": "CSV & Excel Plot (graph view)",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ]
      },
      {
        "viewType": "csvPlot.excelGraph",
        "displayName": "CSV & Excel Plot (Excel graph view)",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "*.xls"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "csvPlot.openGraph",
        "title": "Open as Graph",
        "category": "CSV & Excel Plot",
        "icon": "$(graph-line)"
      },
      {
        "command": "csvPlot.showRaw",
        "title": "Show Raw CSV",
        "category": "CSV & Excel Plot",
        "icon": "$(file-code)"
      },
      {
        "command": "csvPlot.reload",
        "title": "Reload Workbook",
        "category": "CSV & Excel Plot",
        "icon": "$(refresh)"
      },
      {
        "command": "csvPlot.menu.lines",
        "title": "Show as Lines",
        "category": "CSV & Excel Plot",
        "icon": "$(graph-line)"
      },
      {
        "command": "csvPlot.menu.stacked",
        "title": "Show as Stacked Areas",
        "category": "CSV & Excel Plot",
        "icon": "$(graph-left)"
      },
      {
        "command": "csvPlot.menu.histogram",
        "title": "Show Histogram",
        "category": "CSV & Excel Plot",
        "icon": "$(graph)"
      },
      {
        "command": "csvPlot.menu.plotOnly",
        "title": "Plot Only This Column",
        "category": "CSV & Excel Plot",
        "icon": "$(graph-line)"
      },
      {
        "command": "csvPlot.menu.histogramOf",
        "title": "Show Histogram of This Column",
        "category": "CSV & Excel Plot",
        "icon": "$(graph)"
      },
      {
        "command": "csvPlot.menu.useAsX",
        "title": "Use as X Axis",
        "category": "CSV & Excel Plot",
        "icon": "$(arrow-right)"
      },
      {
        "command": "csvPlot.menu.copyColumnName",
        "title": "Copy Column Name",
        "category": "CSV & Excel Plot",
        "icon": "$(copy)"
      },
      {
        "command": "csvPlot.menu.resetZoom",
        "title": "Reset Zoom",
        "category": "CSV & Excel Plot",
        "icon": "$(zoom-out)"
      },
      {
        "command": "csvPlot.menu.hidePanel",
        "title": "Hide Panel",
        "category": "CSV & Excel Plot",
        "icon": "$(layout-sidebar-left-off)"
      },
      {
        "command": "csvPlot.menu.showPanel",
        "title": "Show Panel",
        "category": "CSV & Excel Plot",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "csvPlot.menu.savePng",
        "title": "Save Chart as PNG…",
        "category": "CSV & Excel Plot",
        "icon": "$(save)"
      },
      {
        "command": "csvPlot.menu.copyStats",
        "title": "Copy Statistics",
        "category": "CSV & Excel Plot",
        "icon": "$(copy)"
      },
      {
        "command": "csvPlot.menu.showRaw",
        "title": "Show Raw CSV",
        "category": "CSV & Excel Plot",
        "icon": "$(file-code)"
      },
      {
        "command": "csvPlot.menu.reload",
        "title": "Reload Workbook",
        "category": "CSV & Excel Plot",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "csvPlot.openGraph",
          "when": "((resourceExtname == .csv || resourceExtname == .tsv) && activeCustomEditorId != csvPlot.graph) || ((resourceExtname == .xlsx || resourceExtname == .xlsm || resourceExtname == .xls) && activeCustomEditorId != csvPlot.excelGraph)",
          "group": "navigation"
        },
        {
          "command": "csvPlot.showRaw",
          "when": "activeCustomEditorId == csvPlot.graph",
          "group": "navigation"
        },
        {
          "command": "csvPlot.reload",
          "when": "activeCustomEditorId == csvPlot.excelGraph",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "csvPlot.showRaw",
          "when": "activeCustomEditorId == csvPlot.graph"
        },
        {
          "command": "csvPlot.reload",
          "when": "activeCustomEditorId == csvPlot.excelGraph"
        },
        {
          "command": "csvPlot.menu.lines",
          "when": "false"
        },
        {
          "command": "csvPlot.menu.stacked",
          "when": "false"
        },
        {
          "command": "csvPlot.menu.histogram",
          "when": "false"
        },
        {
          "command": "csvPlot.menu.plotOnly",
          "when": "false"
        },
        {
          "command": "csvPlot.menu.histogramOf",
          "when": "false"
        },
        {
          "command": "csvPlot.menu.useAsX",
          "when": "false"
        },
        {
          "command": "csvPlot.menu.copyColumnName",
          "when": "false"
        },
        {
          "command": "csvPlot.menu.resetZoom",
          "when": "false"
        },
        {
          "command": "csvPlot.menu.hidePanel",
          "when": "false"
        },
        {
          "command": "csvPlot.menu.showPanel",
          "when": "false"
        },
        {
          "command": "csvPlot.menu.savePng",
          "when": "false"
        },
        {
          "command": "csvPlot.menu.copyStats",
          "when": "false"
        },
        {
          "command": "csvPlot.menu.showRaw",
          "when": "false"
        },
        {
          "command": "csvPlot.menu.reload",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "csvPlot.menu.lines",
          "when": "webviewId =~ /^csvPlot\\./ && webviewSection == chart && hasChart && mode != lines",
          "group": "1_mode@1"
        },
        {
          "command": "csvPlot.menu.stacked",
          "when": "webviewId =~ /^csvPlot\\./ && webviewSection == chart && hasChart && mode != stacked",
          "group": "1_mode@2"
        },
        {
          "command": "csvPlot.menu.histogram",
          "when": "webviewId =~ /^csvPlot\\./ && webviewSection == chart && hasChart && mode != histogram",
          "group": "1_mode@3"
        },
        {
          "command": "csvPlot.menu.plotOnly",
          "when": "webviewId =~ /^csvPlot\\./ && webviewSection == column && plottable",
          "group": "1_column@1"
        },
        {
          "command": "csvPlot.menu.histogramOf",
          "when": "webviewId =~ /^csvPlot\\./ && webviewSection == column && isNumber",
          "group": "1_column@2"
        },
        {
          "command": "csvPlot.menu.useAsX",
          "when": "webviewId =~ /^csvPlot\\./ && webviewSection == column && !isX",
          "group": "1_column@3"
        },
        {
          "command": "csvPlot.menu.copyColumnName",
          "when": "webviewId =~ /^csvPlot\\./ && webviewSection == column",
          "group": "2_copy@1"
        },
        {
          "command": "csvPlot.menu.resetZoom",
          "when": "webviewId =~ /^csvPlot\\./ && webviewSection == chart && hasChart",
          "group": "2_view@1"
        },
        {
          "command": "csvPlot.menu.hidePanel",
          "when": "webviewId =~ /^csvPlot\\./ && webviewSection == chart && !panelHidden",
          "group": "2_view@2"
        },
        {
          "command": "csvPlot.menu.showPanel",
          "when": "webviewId =~ /^csvPlot\\./ && webviewSection == chart && panelHidden",
          "group": "2_view@2"
        },
        {
          "command": "csvPlot.menu.savePng",
          "when": "webviewId =~ /^csvPlot\\./ && webviewSection == chart && hasChart",
          "group": "3_export@1"
        },
        {
          "command": "csvPlot.menu.copyStats",
          "when": "webviewId =~ /^csvPlot\\./ && statsShown && webviewSection != column",
          "group": "3_export@2"
        },
        {
          "command": "csvPlot.menu.showRaw",
          "when": "webviewId =~ /^csvPlot\\./ && webviewId == csvPlot.graph && webviewSection != column",
          "group": "4_file@1"
        },
        {
          "command": "csvPlot.menu.reload",
          "when": "webviewId =~ /^csvPlot\\./ && webviewId == csvPlot.excelGraph && webviewSection != column",
          "group": "4_file@1"
        }
      ]
    },
    "configuration": {
      "title": "CSV & Excel Plot",
      "properties": {
        "csvPlot.confirmAboveMB": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "description": "Ask for confirmation before plotting a file larger than this size (in MB). 0 disables the confirmation."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:browser": "npm run build && node test/browser/run.mjs",
    "test:vscode": "npm run build && tsc -p test/vscode && node out/test/vscode/runTest.js",
    "test:vscode:multiroot": "npm run build && tsc -p test/vscode && node out/test/vscode/runMultiRoot.js",
    "package": "npm run notices && npm run build -- --production && vsce package --no-dependencies",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "playwright-core": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
